# The Lab Indonesia - Server Configuration
PORT=3050

# ===============================================================
# PostgreSQL Database Configuration
# ===============================================================
# OPTION 1: Cloud PostgreSQL (Recommended - e.g. Supabase, Neon.tech, Railway)
# Paste your provider's pooled/direct connection URI here:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require

# OPTION 2: Individual Host Parameters (Local or VPS)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_postgres_password
PGDATABASE=thelab_training
# Set PGSSL=true if connecting to remote server requiring SSL:
PGSSL=false

# Session Security
SESSION_SECRET=thelab_indonesia_secret_key_2026_super_secure

# Default Admin Credentials (Auto-created in PostgreSQL on first migration)
ADMIN_NAME=Farhan Laudza
ADMIN_EMAIL=admin@thelabindonesia.my.id
ADMIN_PASSWORD=TheLab2026!Admin
